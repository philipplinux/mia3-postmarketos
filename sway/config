# Phone GPU terminal on tty2 (~/.config/sway/config): tabs tty2-tty4 are workspaces 2-4, each with a foot shell,
# tty1 = the stock fbcon console on VT 1 (kernel messages)
# The shells sit above the wvkbd touch keyboard. Started from ~/.bash_profile on tty2; the power key stays with mia3-display.
output DSI-1 scale 2 bg #000000 solid_color
input type:touch map_to_output DSI-1
seat * hide_cursor 1000
default_border none
# tty1-tty4 tabs (ttybar.py); the bar also keeps text out of the rounded top corners
bar {
    position top
    height 32
    font JetBrainsMono Nerd Font 11
    workspace_buttons no
    status_padding 0
    status_edge_padding 0
    status_command python3 ~/.config/sway/ttybar.py
    colors {
        background #1e1e1e
        statusline #ffffff
    }
}
assign [app_id="tty2"] workspace 2
assign [app_id="tty3"] workspace 3
assign [app_id="tty4"] workspace 4
exec ~/.config/sway/respawn.sh wvkbd-mobintl -H 270
# each foot comes back when closed (exit)
exec ~/.config/sway/respawn.sh foot -a tty2
# first boot only: tty3/4 wait until tty2's ble.sh has built its cache, else all three build it at once and race on mv
exec sh -c '[ -d ~/.cache/blesh ] || sleep 30; exec ~/.config/sway/respawn.sh foot -a tty3'
exec sh -c '[ -d ~/.cache/blesh ] || sleep 30; exec ~/.config/sway/respawn.sh foot -a tty4'
workspace 2
