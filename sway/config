# Phone GPU terminal on tty5 (~/.config/sway/config): foot full screen above the wvkbd touch keyboard.
# Started from ~/.bash_profile on tty5; the power key stays with mia3-display (it grabs the key).
output DSI-1 scale 2 bg #000000 solid_color
input type:touch map_to_output DSI-1
seat * hide_cursor 1000
default_border none
# top gap: the rounded panel corners cut the first line otherwise
gaps top 18
exec wvkbd-mobintl -H 270
# foot comes back when closed (exit)
exec sh -c 'while :; do foot; sleep 1; done'
