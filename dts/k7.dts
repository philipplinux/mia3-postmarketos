/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Xiaomi Mi A3";
	compatible = "xiaomi,laurel-sprout", "qcom,sm6125";
	chassis-type = "handset";
	qcom,msm-id = <0x18a 0x00>;
	qcom,board-id = <0x0b 0x00>;

	aliases {
		serial1 = "/soc@0/geniqup@4cc0000/serial@4c90000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0x5c000000 0x00 0x448e00>;
			width = <0x2d0>;
			height = <0x618>;
			stride = <0xb40>;
			format = "a8r8g8b8";
		};
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			phandle = <0x0e>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			clock-output-names = "sleep_clk";
			phandle = <0x14>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			qcom,freq-domain = <0x90 0x0>;
			#cooling-cells = <0x02>;
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			next-level-cache = <0x02>;
			phandle = <0x04>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x02>;
			};
		};

		cpu@1 {
			qcom,freq-domain = <0x90 0x0>;
			#cooling-cells = <0x02>;
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			next-level-cache = <0x02>;
			phandle = <0x05>;
		};

		cpu@2 {
			qcom,freq-domain = <0x90 0x0>;
			#cooling-cells = <0x02>;
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x02>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			next-level-cache = <0x02>;
			phandle = <0x06>;
		};

		cpu@3 {
			qcom,freq-domain = <0x90 0x0>;
			#cooling-cells = <0x02>;
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			next-level-cache = <0x02>;
			phandle = <0x07>;
		};

		cpu@100 {
			qcom,freq-domain = <0x90 0x1>;
			#cooling-cells = <0x02>;
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x666>;
			next-level-cache = <0x03>;
			phandle = <0x08>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x03>;
			};
		};

		cpu@101 {
			qcom,freq-domain = <0x90 0x1>;
			#cooling-cells = <0x02>;
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x101>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x666>;
			next-level-cache = <0x03>;
			phandle = <0x09>;
		};

		cpu@102 {
			qcom,freq-domain = <0x90 0x1>;
			#cooling-cells = <0x02>;
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x102>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x666>;
			next-level-cache = <0x03>;
			phandle = <0x0a>;
		};

		cpu@103 {
			qcom,freq-domain = <0x90 0x1>;
			#cooling-cells = <0x02>;
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x103>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x666>;
			next-level-cache = <0x03>;
			phandle = <0x0b>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x04>;
				};

				core1 {
					cpu = <0x05>;
				};

				core2 {
					cpu = <0x06>;
				};

				core3 {
					cpu = <0x07>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x08>;
				};

				core1 {
					cpu = <0x09>;
				};

				core2 {
					cpu = <0x0a>;
				};

				core3 {
					cpu = <0x0b>;
				};
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-sm6125", "qcom,scm";
			#reset-cells = <0x01>;
		};
	};

	memory@40000000 {
		reg = <0x00 0x40000000 0x00 0x00>;
		device_type = "memory";
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x06 0x04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	remoteproc {
		compatible = "qcom,sm6125-rpm-proc", "qcom,rpm-proc";

		glink-edge {
			compatible = "qcom,glink-rpm";
			interrupts = <0x00 0xc2 0x01>;
			qcom,rpm-msg-ram = <0x0c>;
			mboxes = <0x0d 0x00>;

			rpm-requests {
				compatible = "qcom,rpm-sm6125", "qcom,glink-smd-rpm";
				qcom,glink-channels = "rpm_requests";

				clock-controller {
					compatible = "qcom,rpmcc-sm6125", "qcom,rpmcc";
					#clock-cells = <0x01>;
					clocks = <0x0e>;
					clock-names = "xo";
					phandle = <0x13>;
				};

				power-controller {
					compatible = "qcom,sm6125-rpmpd";
					#power-domain-cells = <0x01>;
					operating-points-v2 = <0x0f>;
					phandle = <0x22>;

					opp-table {
						compatible = "operating-points-v2";
						phandle = <0x0f>;

						opp1 {
							opp-level = <0x10>;
							phandle = <0x70>;
						};

						opp2 {
							opp-level = <0x20>;
						};

						opp3 {
							opp-level = <0x30>;
						};

						opp4 {
							opp-level = <0x40>;
							phandle = <0x5c>;
						};

						opp5 {
							opp-level = <0x80>;
							phandle = <0x5d>;
						};

						opp6 {
							opp-level = <0xc0>;
							phandle = <0x5e>;
						};

						opp7 {
							opp-level = <0x100>;
							phandle = <0x5f>;
						};

						opp8 {
							opp-level = <0x140>;
							phandle = <0x60>;
						};

						opp9 {
							opp-level = <0x180>;
							phandle = <0x61>;
						};

						opp10 {
							opp-level = <0x1a0>;
							phandle = <0x62>;
						};
					};
				};

				regulators-0 {
					compatible = "qcom,rpm-pm6125-regulators";

					s6 {
						regulator-min-microvolt = <0xe4840>;
						regulator-max-microvolt = <0x15b2b0>;
					};

					l1 {
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x132a40>;
					};

					l2 {
						regulator-min-microvolt = <0xf4240>;
						regulator-max-microvolt = <0x101d00>;
					};

					l3 {
						regulator-min-microvolt = <0xf4240>;
						regulator-max-microvolt = <0x103c40>;
					};

					l4 {
						regulator-min-microvolt = <0xd4e40>;
						regulator-max-microvolt = <0xee480>;
						regulator-allow-set-load;
						phandle = <0x2c>;
					};

					l5 {
						regulator-min-microvolt = <0x192580>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-allow-set-load;
						phandle = <0x26>;
					};

					l6 {
						regulator-min-microvolt = <0x8ca00>;
						regulator-max-microvolt = <0xa0280>;
					};

					l7 {
						regulator-min-microvolt = <0xd4e40>;
						regulator-max-microvolt = <0xee480>;
						phandle = <0x16>;
					};

					l8 {
						regulator-min-microvolt = <0x61a80>;
						regulator-max-microvolt = <0xb1bc0>;
						phandle = <0x78>;
					};

					l9 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1cee40>;
						phandle = <0x81>;
					};

					l10 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1cee40>;
						regulator-allow-set-load;
						phandle = <0x17>;
					};

					l11 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1dc900>;
						regulator-allow-set-load;
						phandle = <0x29>;
					};

					l12 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1e74e0>;
					};

					l13 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1bf440>;
					};

					l14 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1d0d80>;
					};

					l15 {
						regulator-min-microvolt = "", "/]";
						regulator-max-microvolt = "", "1Q";
						phandle = <0x18>;
					};

					l16 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1d0d80>;
						phandle = <0x79>;
					};

					l17 {
						regulator-min-microvolt = <0x130b00>;
						regulator-max-microvolt = <0x13e5c0>;
						phandle = <0x7a>;
					};

					l18 {
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x134980>;
						regulator-allow-set-load;
						phandle = <0x2a>;
					};

					l19 {
						regulator-min-microvolt = <0x192580>;
						regulator-max-microvolt = <0x2d0b40>;
					};

					l20 {
						regulator-min-microvolt = <0x192580>;
						regulator-max-microvolt = <0x2d0b40>;
					};

					l21 {
						regulator-min-microvolt = <0x27ac40>;
						regulator-max-microvolt = <0x2b9440>;
					};

					l22 {
						regulator-min-microvolt = <0x2cec00>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-allow-set-load;
						phandle = <0x25>;
					};

					l23 {
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-max-microvolt = <0x33e140>;
						phandle = <0x7b>;
					};

					l24 {
						regulator-min-microvolt = <0x2cec00>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-allow-set-load;
						phandle = <0x28>;
					};
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		memory@45700000 {
			reg = <0x00 0x45700000 0x00 0x600000>;
			no-map;
		};

		memory@45e00000 {
			reg = <0x00 0x45e00000 0x00 0x140000>;
			no-map;
		};

		memory@45fff000 {
			reg = <0x00 0x45fff000 0x00 0x1000>;
			no-map;
		};

		memory@46000000 {
			reg = <0x00 0x46000000 0x00 0x200000>;
			no-map;
			phandle = <0x10>;
		};

		memory@46200000 {
			reg = <0x00 0x46200000 0x00 0x4900000>;
			no-map;
		};

		memory@4ab00000 {
			reg = <0x00 0x4ab00000 0x00 0x500000>;
			no-map;
		};

		memory@4b000000 {
			reg = <0x00 0x4b000000 0x00 0x7e00000>;
			no-map;
			phandle = <0x72>;
		};

		memory@52e00000 {
			reg = <0x00 0x52e00000 0x00 0x500000>;
			no-map;
		};

		memory@53300000 {
			reg = <0x00 0x53300000 0x00 0x200000>;
			no-map;
			phandle = <0x77>;
		};

		memory@53500000 {
			reg = <0x00 0x53500000 0x00 0x1e00000>;
			no-map;
			phandle = <0x75>;
		};

		memory@55300000 {
			reg = <0x00 0x55300000 0x00 0x2200000>;
			no-map;
		};

		memory@5c000000 {
			reg = <0x00 0x5c000000 0x00 0xf00000>;
			no-map;
		};

		memory@5cf00000 {
			reg = <0x00 0x5cf00000 0x00 0x100000>;
			no-map;
		};

		memory@5f800000 {
			reg = <0x00 0x5f800000 0x00 0x1e00000>;
			no-map;
		};

		memory@5e400000 {
			reg = <0x00 0x5e400000 0x00 0x1400000>;
			no-map;
		};

		memory@f3000000 {
			reg = <0x00 0xf3000000 0x00 0x400000>;
			no-map;
		};

		memory@f3400000 {
			reg = <0x00 0xf3400000 0x00 0x800000>;
			no-map;
		};

		memory@13fc00000 {
			reg = <0x01 0x3fc00000 0x00 0x400000>;
			no-map;
		};

		memory@89b01000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x00 0x89b01000 0x00 0x200000>;
			no-map;
			qcom,client-id = <0x01>;
			qcom,vmid = <0x0f 0x2b>;
		};

		debug@ffb00000 {
			reg = <0x00 0xffb00000 0x00 0xc0000>;
			no-map;
		};

		lastlog@ffbc0000 {
			reg = <0x00 0xffbc0000 0x00 0x80000>;
			no-map;
		};

		ramoops@ffc00000 {
			compatible = "ramoops";
			reg = <0x00 0xffc40000 0x00 0xc0000>;
			record-size = <0x1000>;
			console-size = <0x40000>;
			pmsg-size = <0x20000>;
		};

		memory@ffd00000 {
			reg = <0x00 0xffd40000 0x00 0x1000>;
			no-map;
		};

		memory@57500000 {
			reg = <0x00 0x57500000 0x00 0x10000>;
			no-map;
		};

		memory@57510000 {
			reg = <0x00 0x57510000 0x00 0x5000>;
			no-map;
		};

		memory@57515000 {
			reg = <0x00 0x57515000 0x00 0x2000>;
			no-map;
			phandle = <0x5b>;
		};
	};

	smem {
		compatible = "qcom,smem";
		memory-region = <0x10>;
		hwlocks = <0x11 0x03>;
	};

	smp2p-mpss {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupts = <0x00 0x46 0x01>;
		mboxes = <0x0d 0x0e>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x73>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x71>;
		};
	};

	smp2p-cdsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x5e 0x1b0>;
		interrupts = <0x00 0x107 0x01>;
		mboxes = <0x0d 0x1e>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x05>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x76>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x74>;
		};
	};

	soc@0 {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;
		dma-ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;
		compatible = "simple-bus";

		hwlock@340000 {
			compatible = "qcom,tcsr-mutex";
			reg = <0x00 0x340000 0x00 0x20000>;
			#hwlock-cells = <0x01>;
			phandle = <0x11>;
		};

		pinctrl@500000 {
			compatible = "qcom,sm6125-tlmm";
			reg = <0x00 0x500000 0x00 0x400000 0x00 0x900000 0x00 0x400000 0x00 0xd00000 0x00 0x400000>;
			reg-names = "west", "south", "east";
			interrupts = <0x00 0xe3 0x04>;
			gpio-controller;
			gpio-ranges = <0x12 0x00 0x00 0x86>;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			gpio-reserved-ranges = <0x16 0x02 0x1c 0x06>;
			phandle = <0x12>;

			sdc2-off-state {
				phandle = <0x24>;

				clk-pins {
					pins = "sdc2_clk";
					drive-strength = <0x02>;
					bias-disable;
				};

				cmd-pins {
					pins = "sdc2_cmd";
					drive-strength = <0x02>;
					bias-pull-up;
				};

				data-pins {
					pins = "sdc2_data";
					drive-strength = <0x02>;
					bias-pull-up;
				};

				sd-cd-pins {
					pins = "gpio98";
					function = "gpio";
					drive-strength = <0x02>;
					bias-disable;
				};
			};

			sdc2-on-state {
				phandle = <0x23>;

				clk-pins {
					pins = "sdc2_clk";
					drive-strength = <0x10>;
					bias-disable;
				};

				cmd-pins {
					pins = "sdc2_cmd";
					drive-strength = <0x0a>;
					bias-pull-up;
				};

				data-pins {
					pins = "sdc2_data";
					drive-strength = <0x0a>;
					bias-pull-up;
				};

				sd-cd-pins {
					pins = "gpio98";
					function = "gpio";
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			qup-i2c0-default-state {
				pins = "gpio0", "gpio1";
				function = "qup00";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x2d>;
			};

			qup-i2c0-sleep-state {
				pins = "gpio0", "gpio1";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
				phandle = <0x2e>;
			};

			qup-i2c1-default-state {
				pins = "gpio4", "gpio5";
				function = "qup01";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x32>;
			};

			qup-i2c1-sleep-state {
				pins = "gpio4", "gpio5";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
				phandle = <0x33>;
			};

			qup-i2c2-default-state {
				pins = "gpio6", "gpio7";
				function = "qup02";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x34>;
			};

			qup-i2c2-sleep-state {
				pins = "gpio6", "gpio7";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
				phandle = <0x35>;
			};

			qup-i2c3-default-state {
				pins = "gpio14", "gpio15";
				function = "qup03";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x3d>;
			};

			qup-i2c3-sleep-state {
				pins = "gpio14", "gpio15";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
				phandle = <0x3e>;
			};

			qup-i2c4-default-state {
				pins = "gpio16", "gpio17";
				function = "qup04";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x3f>;
			};

			qup-i2c4-sleep-state {
				pins = "gpio16", "gpio17";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
				phandle = <0x40>;
			};

			qup-i2c5-default-state {
				pins = "gpio22", "gpio23";
				function = "qup10";
				drive-strength = <0x02>;
