				clock-names = "bus", "iface", "rot", "lut", "core", "vsync", "throttle";
				assigned-clocks = <0x63 0x19>;
				assigned-clock-rates = <0x124f800>;
				operating-points-v2 = <0x65>;
				power-domains = <0x22 0x00>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x66>;
							phandle = <0x69>;
						};
					};
				};

				opp-table {
					compatible = "operating-points-v2";
					phandle = <0x65>;

					opp-192000000 {
						opp-hz = <0x00 0xb71b000>;
						required-opps = <0x5c>;
					};

					opp-256000000 {
						opp-hz = <0x00 0xf424000>;
						required-opps = <0x5d>;
					};

					opp-307200000 {
						opp-hz = <0x00 0x124f8000>;
						required-opps = <0x5e>;
					};

					opp-384000000 {
						opp-hz = <0x00 0x16e36000>;
						required-opps = <0x5f>;
					};

					opp-400000000 {
						opp-hz = <0x00 0x17d78400>;
						required-opps = <0x61>;
					};
				};
			};

			dsi@5e94000 {
				compatible = "qcom,sm6125-dsi-ctrl", "qcom,mdss-dsi-ctrl";
				reg = <0x00 0x5e94000 0x00 0x400>;
				reg-names = "dsi_ctrl";
				interrupt-parent = <0x64>;
				interrupts = <0x04>;
				clocks = <0x63 0x03 0x63 0x05 0x63 0x15 0x63 0x0f 0x63 0x01 0x15 0x68>;
				clock-names = "byte", "byte_intf", "pixel", "core", "iface", "bus";
				assigned-clocks = <0x63 0x04 0x63 0x16>;
				assigned-clock-parents = <0x67 0x00 0x67 0x01>;
				operating-points-v2 = <0x68>;
				power-domains = <0x22 0x00>;
				phys = <0x67>;
				phy-names = "dsi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";
				vdda-supply = <0x2a>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x69>;
							phandle = <0x66>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							data-lanes = <0x00 0x01 0x02 0x03>;
							remote-endpoint = <0x6a>;
							phandle = <0x6f>;
						};
					};
				};

				opp-table {
					compatible = "operating-points-v2";
					phandle = <0x68>;

					opp-164000000 {
						opp-hz = <0x00 0x9c67100>;
						required-opps = <0x5c>;
					};

					opp-187500000 {
						opp-hz = <0x00 0xb2d05e0>;
						required-opps = <0x5d>;
					};
				};

				panel@0 {
					compatible = "samsung,s6e8fc0-m1906f9";
					reg = <0x00>;
					reset-gpios = <0x12 0x5a 0x01>;
					pinctrl-0 = <0x6b>;
					pinctrl-1 = <0x6c>;
					pinctrl-names = "default", "sleep";
					vdd-supply = <0x6d>;
					vci-supply = <0x6e>;

					port {

						endpoint {
							remote-endpoint = <0x6f>;
							phandle = <0x6a>;
						};
					};
				};
			};

			phy@5e94400 {
				compatible = "qcom,sm6125-dsi-phy-14nm";
				reg = <0x00 0x5e94400 0x00 0x100 0x00 0x5e94500 0x00 0x300 0x00 0x5e94800 0x00 0x188>;
				reg-names = "dsi_phy", "dsi_phy_lane", "dsi_pll";
				#clock-cells = <0x01>;
				#phy-cells = <0x00>;
				clocks = <0x63 0x01 0x13 0x00>;
				clock-names = "iface", "ref";
				required-opps = <0x5f>;
				power-domains = <0x22 0x03>;
				status = "okay";
				phandle = <0x67>;
			};
		};

		clock-controller@5f00000 {
			compatible = "qcom,sm6125-dispcc";
			reg = <0x00 0x5f00000 0x00 0x20000>;
			clocks = <0x13 0x00 0x67 0x00 0x67 0x01 0x00 0x00 0x00 0x15 0x66 0x15 0x67>;
			clock-names = "bi_tcxo", "dsi0_phy_pll_out_byteclk", "dsi0_phy_pll_out_dsiclk", "dsi1_phy_pll_out_dsiclk", "dp_phy_pll_link_clk", "dp_phy_pll_vco_div_clk", "cfg_ahb_clk", "gcc_disp_gpll0_div_clk_src";
			required-opps = <0x70>;
			power-domains = <0x22 0x00>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#power-domain-cells = <0x01>;
			status = "okay";
			phandle = <0x63>;
		};

		iommu@c600000 {
			compatible = "qcom,sm6125-smmu-500", "qcom,smmu-500", "arm,mmu-500";
			reg = <0x00 0xc600000 0x00 0x80000>;
			interrupts = <0x00 0x51 0x04 0x00 0x58 0x04 0x00 0x59 0x04 0x00 0x5a 0x04 0x00 0x5b 0x04 0x00 0x5c 0x04 0x00 0x5d 0x04 0x00 0x5e 0x04 0x00 0x5f 0x04 0x00 0x60 0x04 0x00 0x61 0x04 0x00 0x62 0x04 0x00 0x63 0x04 0x00 0x64 0x04 0x00 0x65 0x04 0x00 0x66 0x04 0x00 0x67 0x04 0x00 0x68 0x04 0x00 0x69 0x04 0x00 0x6a 0x04 0x00 0x6b 0x04 0x00 0x6c 0x04 0x00 0x6d 0x04 0x00 0x6e 0x04 0x00 0x6f 0x04 0x00 0x70 0x04 0x00 0x71 0x04 0x00 0x72 0x04 0x00 0x73 0x04 0x00 0x74 0x04 0x00 0x75 0x04 0x00 0x76 0x04 0x00 0x77 0x04 0x00 0x78 0x04 0x00 0x79 0x04 0x00 0x7a 0x04 0x00 0x7b 0x04 0x00 0x7c 0x04 0x00 0x7d 0x04 0x00 0x7e 0x04 0x00 0x7f 0x04 0x00 0x80 0x04 0x00 0x81 0x04 0x00 0x82 0x04 0x00 0x83 0x04 0x00 0x84 0x04 0x00 0x85 0x04 0x00 0x86 0x04 0x00 0x87 0x04 0x00 0x88 0x04 0x00 0x89 0x04 0x00 0x8a 0x04 0x00 0x8b 0x04 0x00 0x8c 0x04 0x00 0x8d 0x04 0x00 0x8e 0x04 0x00 0x8f 0x04 0x00 0x90 0x04 0x00 0x91 0x04 0x00 0x92 0x04 0x00 0x93 0x04 0x00 0x94 0x04 0x00 0x95 0x04 0x00 0x96 0x04 0x00 0x97 0x04>;
			#global-interrupts = <0x01>;
			#iommu-cells = <0x02>;
			phandle = <0x21>;
		};

		remoteproc@6080000 {
			compatible = "qcom,sm6115-mpss-pas";
			reg = <0x00 0x6080000 0x00 0x10000>;
			firmware-name = "qcom/sm6125/xiaomi/laurel/modem.mdt";
			interrupts-extended = <0x01 0x00 0x133 0x01 0x71 0x00 0x01 0x71 0x01 0x01 0x71 0x02 0x01 0x71 0x03 0x01 0x71 0x07 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack", "shutdown-ack";
			clocks = <0x13 0x00>;
			clock-names = "xo";
			power-domains = <0x22 0x00>;
			memory-region = <0x72>;
			qcom,smem-states = <0x73 0x00>;
			qcom,smem-state-names = "stop";
			status = "okay";

			glink-edge {
				interrupts = <0x00 0x44 0x01>;
				label = "mpss";
				qcom,remote-pid = <0x01>;
				mboxes = <0x0d 0x0c>;
			};
		};

		remoteproc@b300000 {
			compatible = "qcom,sm6115-cdsp-pas";
			reg = <0x00 0xb300000 0x00 0x4040>;
			firmware-name = "qcom/sm6125/xiaomi/laurel/cdsp.mdt";
			interrupts-extended = <0x01 0x00 0x109 0x01 0x74 0x00 0x01 0x74 0x01 0x01 0x74 0x02 0x01 0x74 0x03 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack";
			clocks = <0x13 0x00>;
			clock-names = "xo";
			power-domains = <0x22 0x00>;
			memory-region = <0x75>;
			qcom,smem-states = <0x76 0x00>;
			qcom,smem-state-names = "stop";
			status = "okay";

			glink-edge {
				interrupts = <0x00 0x105 0x01>;
				label = "cdsp";
				qcom,remote-pid = <0x05>;
				mboxes = <0x0d 0x1c>;
			};
		};

		wifi@c800000 {
			compatible = "qcom,wcn3990-wifi";
			reg = <0x00 0xc800000 0x00 0x800000>;
			reg-names = "membase";
			memory-region = <0x77>;
			interrupts = <0x00 0x166 0x04 0x00 0x167 0x04 0x00 0x168 0x04 0x00 0x169 0x04 0x00 0x16a 0x04 0x00 0x16b 0x04 0x00 0x16c 0x04 0x00 0x16d 0x04 0x00 0x16e 0x04 0x00 0x16f 0x04 0x00 0x170 0x04 0x00 0x171 0x04>;
			iommus = <0x21 0x80 0x01>;
			status = "okay";
			vdd-0.8-cx-mx-supply = <0x78>;
			vdd-1.8-xo-supply = <0x79>;
			vdd-1.3-rfa-supply = <0x7a>;
			vdd-3.3-ch0-supply = <0x7b>;
			firmware-name = "laurel";
		};

		cpufreq@f521000 {
			compatible = "qcom,sm6125-cpufreq-hw", "qcom,cpufreq-hw";
			reg = <0x00 0xf521000 0x00 0x1000>, <0x00 0xf523000 0x00 0x1000>;
			reg-names = "freq-domain0", "freq-domain1";
			clocks = <0x13 0x00>, <0x15 0x06>;
			clock-names = "xo", "alternate";
			#freq-domain-cells = <0x01>;
			#clock-cells = <0x01>;
			phandle = <0x90>;
		};

		mailbox@f111000 {
			compatible = "qcom,sm6125-apcs-hmss-global", "qcom,msm8994-apcs-kpss-global";
			reg = <0x00 0xf111000 0x00 0x1000>;
			#mbox-cells = <0x01>;
			phandle = <0x0d>;
		};

		timer@f120000 {
			compatible = "arm,armv7-timer-mem";
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			reg = <0x00 0xf120000 0x00 0x1000>;
			ranges = <0x00 0x00 0x00 0x00 0x20000000>;
			clock-frequency = <0x124f800>;

			frame@f121000 {
				frame-number = <0x00>;
				interrupts = <0x00 0x08 0x04 0x00 0x07 0x04>;
				reg = <0x00 0xf121000 0x1000 0x00 0xf122000 0x1000>;
			};

			frame@f123000 {
				frame-number = <0x01>;
				interrupts = <0x00 0x09 0x04>;
				reg = <0x00 0xf123000 0x1000>;
				status = "disabled";
			};

			frame@f124000 {
				frame-number = <0x02>;
				interrupts = <0x00 0x0a 0x04>;
				reg = <0x00 0xf124000 0x1000>;
				status = "disabled";
			};

			frame@f125000 {
				frame-number = <0x03>;
				interrupts = <0x00 0x0b 0x04>;
				reg = <0x00 0xf125000 0x1000>;
				status = "disabled";
			};

			frame@f126000 {
				frame-number = <0x04>;
				interrupts = <0x00 0x0c 0x04>;
				reg = <0x00 0xf126000 0x1000>;
				status = "disabled";
			};

			frame@f127000 {
				frame-number = <0x05>;
				interrupts = <0x00 0x0d 0x04>;
				reg = <0x00 0xf127000 0x1000>;
				status = "disabled";
			};

			frame@f128000 {
				frame-number = <0x06>;
				interrupts = <0x00 0x0e 0x04>;
				reg = <0x00 0xf128000 0x1000>;
				status = "disabled";
			};
		};

		interrupt-controller@f200000 {
			compatible = "arm,gic-v3";
			reg = <0x00 0xf200000 0x00 0x20000 0x00 0xf300000 0x00 0x100000>;
			#interrupt-cells = <0x03>;
			interrupt-controller;
			interrupts = <0x01 0x09 0x04>;
			phandle = <0x01>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x01 0x08 0x01 0x02 0x08 0x01 0x03 0x08 0x01 0x00 0x08>;
		clock-frequency = <0x124f800>;
	};

	thermal-zones {

		pm6125-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x7c>;

			trips {

				trip0 {
					temperature = <0x17318>;
					hysteresis = <0x00>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "hot";
				};

				trip2 {
					temperature = <0x23668>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};
		};

		pmi632-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x7d>;

			trips {

				trip0 {
					temperature = <0x17318>;
					hysteresis = <0x00>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "hot";
				};

				trip2 {
					temperature = <0x1e848>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};
		};

		rf-pa0-thermal {
			thermal-sensors = <0x7e 0x00>;

			trips {

				active-config0 {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		quiet-thermal {
			thermal-sensors = <0x7e 0x01>;

			trips {

				active-config0 {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		xo-thermal {
			thermal-sensors = <0x7e 0x02>;

			trips {

				active-config0 {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x7f>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			gpios = <0x1c 0x05 0x01>;
			linux,code = <0x73>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};
	};

	regulator-ts-vdd {
		compatible = "regulator-fixed";
		regulator-name = "ts_vdd_supply";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		startup-delay-us = <0x11170>;
		enable-active-high;
		gpio = <0x12 0x53 0x00>;
		pinctrl-0 = <0x80>;
		pinctrl-names = "default";
		phandle = <0x36>;
	};

	regulator-panel-vdd {
		compatible = "regulator-fixed";
		regulator-name = "panel_vdd_1p8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-boot-on;
		vin-supply = <0x81>;
		enable-active-high;
		gpio = <0x12 0x1a 0x00>;
		pinctrl-0 = <0x82>;
		pinctrl-names = "default";
		phandle = <0x6d>;
	};

	regulator-panel-vci {
		compatible = "regulator-fixed";
		regulator-name = "panel_vci_3p0";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-boot-on;
		enable-active-high;
		gpio = <0x12 0x7c 0x00>;
		pinctrl-0 = <0x83>;
		pinctrl-names = "default";
		phandle = <0x6e>;
	};
};
