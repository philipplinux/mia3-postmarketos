		clock-controller@1400000 {
			compatible = "qcom,gcc-sm6125";
			reg = <0x00 0x1400000 0x00 0x1f0000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#power-domain-cells = <0x01>;
			clock-names = "bi_tcxo", "sleep_clk";
			clocks = <0x13 0x00 0x14>;
			phandle = <0x15>;
		};

		phy@1613000 {
			compatible = "qcom,msm8996-qusb2-phy";
			reg = <0x00 0x1613000 0x00 0x180>;
			#phy-cells = <0x00>;
			clocks = <0x15 0x0f 0x13 0x00>;
			clock-names = "cfg_ahb", "ref";
			resets = <0x15 0x00>;
			status = "okay";
			vdd-supply = <0x16>;
			vdda-pll-supply = <0x17>;
			vdda-phy-dpdm-supply = <0x18>;
			phandle = <0x55>;
		};

		rng@1b53000 {
			compatible = "qcom,prng-ee";
			reg = <0x00 0x1b53000 0x00 0x1000>;
			clocks = <0x15 0x7d>;
			clock-names = "core";
		};

		spmi@1c40000 {
			compatible = "qcom,spmi-pmic-arb";
			reg = <0x00 0x1c40000 0x00 0x1100 0x00 0x1e00000 0x00 0x2000000 0x00 0x3e00000 0x00 0x100000 0x00 0x3f00000 0x00 0xa0000 0x00 0x1c0a000 0x00 0x26000>;
			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
			interrupt-names = "periph_irq";
			interrupts = <0x00 0xb7 0x04>;
			qcom,ee = <0x00>;
			qcom,channel = <0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			pmic@0 {
				compatible = "qcom,pm6125", "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pon@800 {
					compatible = "qcom,pm8998-pon";
					reg = <0x800>;
					mode-bootloader = <0x02>;
					mode-recovery = <0x01>;

					pwrkey {
						compatible = "qcom,pm8941-pwrkey";
						interrupts = <0x00 0x08 0x00 0x03>;
						debounce = <0x3d09>;
						linux,code = <0x74>;
						bias-pull-up;
						status = "okay";
					};

					resin {
						compatible = "qcom,pm8941-resin";
						interrupts = <0x00 0x08 0x01 0x03>;
						debounce = <0x3d09>;
						bias-pull-up;
						status = "okay";
						linux,code = <0x72>;
					};
				};

				temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x00 0x24 0x00 0x01>;
					io-channels = <0x19 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					phandle = <0x7c>;
				};

				adc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x31 0x00 0x01>;
					#io-channel-cells = <0x01>;
					pinctrl-names = "default";
					pinctrl-0 = <0x1a 0x1b>;
					phandle = <0x19>;

					channel@0 {
						reg = <0x00>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "ref_gnd";
					};

					channel@1 {
						reg = <0x01>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "vref_1p25";
					};

					channel@6 {
						reg = <0x06>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "die_temp";
					};

					channel@83 {
						reg = <0x83>;
						qcom,pre-scaling = <0x01 0x03>;
						label = "vph_pwr";
					};

					channel@85 {
						reg = <0x85>;
						qcom,pre-scaling = <0x01 0x03>;
						label = "vcoin";
					};

					channel@4c {
						reg = <0x4c>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						label = "xo_therm";
					};

					channel@4d {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "rf_pa0_therm";
					};

					channel@4e {
						reg = <0x4e>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "quiet_therm";
					};

					channel@52 {
						reg = <0x52>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "camera_flash_therm";
					};

					channel@54 {
						reg = <0x54>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "emmc_ufs_therm";
					};
				};

				adc-tm@3500 {
					compatible = "qcom,spmi-adc-tm5";
					reg = <0x3500>;
					interrupts = <0x00 0x35 0x00 0x01>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					status = "okay";
					phandle = <0x7e>;

					rf-pa0-therm@0 {
						reg = <0x00>;
						io-channels = <0x19 0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time-us = <0xc8>;
					};

					quiet-therm@1 {
						reg = <0x01>;
						io-channels = <0x19 0x4e>;
						qcom,ratiometric;
						qcom,hw-settle-time-us = <0xc8>;
					};

					xo-therm@2 {
						reg = <0x02>;
						io-channels = <0x19 0x4c>;
						qcom,ratiometric;
						qcom,hw-settle-time-us = <0xc8>;
					};
				};

				rtc@6000 {
					compatible = "qcom,pm8941-rtc";
					reg = <0x6000 0x6100>;
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x61 0x01 0x01>;
				};

				gpio@c000 {
					compatible = "qcom,pm6125-gpio", "qcom,spmi-gpio";
					reg = <0xc000>;
					gpio-controller;
					gpio-ranges = <0x1c 0x00 0x00 0x09>;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x1c>;

					camera-flash-therm-state {
						pins = "gpio3";
						function = "normal";
						bias-high-impedance;
						phandle = <0x1a>;
					};

					emmc-ufs-therm-state {
						pins = "gpio6";
						function = "normal";
						bias-high-impedance;
						phandle = <0x1b>;
					};

					vol-up-n-state {
						pins = "gpio5";
						function = "normal";
						input-enable;
						bias-pull-up;
						phandle = <0x7f>;
					};
				};
			};

			pmic@1 {
				compatible = "qcom,pm6125", "qcom,spmi-pmic";
				reg = <0x01 0x00>;
			};

			pmic@2 {
				compatible = "qcom,pmi632", "qcom,spmi-pmic";
				reg = <0x02 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				usb-vbus-regulator@1100 {
					compatible = "qcom,pmi632-vbus-reg", "qcom,pm8150b-vbus-reg";
					reg = <0x1100>;
					status = "okay";
					regulator-min-microamp = <0x7a120>;
					regulator-max-microamp = <0xf4240>;
				};

				typec@1500 {
					compatible = "qcom,pmi632-typec";
					reg = <0x1500>;
					interrupts = <0x02 0x15 0x00 0x01 0x02 0x15 0x01 0x03 0x02 0x15 0x02 0x01 0x02 0x15 0x03 0x03 0x02 0x15 0x04 0x01 0x02 0x15 0x05 0x01 0x02 0x15 0x06 0x03 0x02 0x15 0x07 0x01>;
					interrupt-names = "or-rid-detect-change", "vpd-detect", "cc-state-change", "vconn-oc", "vbus-change", "attach-detach", "legacy-cable-detect", "try-snk-src-detect";
					status = "okay";

					connector {
						compatible = "usb-c-connector";
						power-role = "dual";
						data-role = "dual";
						self-powered;
						typec-power-opmode = "default";
						pd-disable;

						port {

							endpoint {
								remote-endpoint = <0x1d>;
								phandle = <0x56>;
							};
						};
					};
				};

				temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x02 0x24 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x7d>;
				};

				adc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#io-channel-cells = <0x01>;
					interrupts = <0x02 0x31 0x00 0x01>;

					channel@0 {
						reg = <0x00>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "ref_gnd";
					};

					channel@1 {
						reg = <0x01>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "vref_1p25";
					};

					channel@6 {
						reg = <0x06>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "die_temp";
					};

					channel@7 {
						reg = <0x07>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "usb_in_i_uv";
					};

					channel@8 {
						reg = <0x08>;
						qcom,pre-scaling = <0x01 0x10>;
						label = "usb_in_v_div_16";
					};

					channel@9 {
						reg = <0x09>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "chg_temp";
					};

					channel@4b {
						reg = <0x4b>;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,ratiometric;
						label = "bat_id";
					};

					channel@83 {
						reg = <0x83>;
						qcom,pre-scaling = <0x01 0x03>;
						label = "vph_pwr";
					};

					channel@84 {
						reg = <0x84>;
						qcom,pre-scaling = <0x01 0x03>;
						label = "vbat_sns";
					};
				};

				adc-tm@3500 {
					compatible = "qcom,spmi-adc-tm5";
					reg = <0x3500>;
					interrupts = <0x02 0x35 0x00 0x01>;
					#thermal-sensor-cells = <0x01>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					status = "disabled";
				};

				pbs@7400 {
					compatible = "qcom,pmi632-pbs", "qcom,pbs";
					reg = <0x7400>;
					phandle = <0x20>;
				};

				nvram@b600 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb600>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					ranges = <0x00 0xb600 0x100>;
					phandle = <0x1f>;
				};

				gpio@c000 {
					compatible = "qcom,pmi632-gpio", "qcom,spmi-gpio";
					reg = <0xc000>;
					gpio-controller;
					gpio-ranges = <0x1e 0x00 0x00 0x08>;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x1e>;
				};
			};

			pmic@3 {
				compatible = "qcom,pmi632", "qcom,spmi-pmic";
				reg = <0x03 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pwm {
					compatible = "qcom,pmi632-lpg";
					nvmem = <0x1f>;
					nvmem-names = "lpg_chan_sdam";
					qcom,pbs = <0x20>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
					status = "disabled";
				};

				vibrator@5700 {
					compatible = "qcom,pmi632-vib";
					reg = <0x5700>;
					status = "disabled";
				};
			};
		};

		sram@45f0000 {
			compatible = "qcom,rpm-msg-ram";
			reg = <0x00 0x45f0000 0x00 0x7000>;
			phandle = <0x0c>;
		};

		mmc@4744000 {
			compatible = "qcom,sm6125-sdhci", "qcom,sdhci-msm-v5";
			reg = <0x00 0x4744000 0x00 0x1000 0x00 0x4745000 0x00 0x1000>;
			reg-names = "hc", "cqhci";
			interrupts = <0x00 0x15c 0x04 0x00 0x160 0x04>;
			interrupt-names = "hc_irq", "pwr_irq";
			clocks = <0x15 0xa3 0x15 0xa4 0x13 0x00>;
			clock-names = "iface", "core", "xo";
			iommus = <0x21 0x160 0x00>;
			power-domains = <0x22 0x00>;
			qcom,dll-config = <0xf642c>;
			qcom,ddr-config = <0x80040873>;
			bus-width = <0x08>;
			non-removable;
			supports-cqe;
			status = "disabled";
		};

		mmc@4784000 {
			compatible = "qcom,sm6125-sdhci", "qcom,sdhci-msm-v5";
			reg = <0x00 0x4784000 0x00 0x1000>;
			reg-names = "hc";
			interrupts = <0x00 0x15e 0x04 0x00 0x161 0x04>;
			interrupt-names = "hc_irq", "pwr_irq";
			clocks = <0x15 0xa8 0x15 0xa9 0x13 0x00>;
			clock-names = "iface", "core", "xo";
			iommus = <0x21 0x180 0x00>;
			pinctrl-0 = <0x23>;
			pinctrl-1 = <0x24>;
			pinctrl-names = "default", "sleep";
			power-domains = <0x22 0x00>;
			qcom,dll-config = <0x7642c>;
			qcom,ddr-config = <0x80040873>;
			bus-width = <0x04>;
			status = "okay";
			cd-gpios = <0x12 0x62 0x00>;
			vmmc-supply = <0x25>;
			vqmmc-supply = <0x26>;
			no-sdio;
			no-mmc;
		};

