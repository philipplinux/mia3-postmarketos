package() {
	install -d "$pkgdir/usr/lib/firmware/qcom/sm6125/xiaomi/laurel"
	for f in $source; do
		[ "$f" = board-2.bin ] && continue
		install -m644 "$srcdir/$f" "$pkgdir/usr/lib/firmware/qcom/sm6125/xiaomi/laurel/"
	done
	# bdwlan.bin wrapped by tools/ath10k-bdenc.py; picked via DT firmware-name = "laurel"
	install -Dm644 "$srcdir/board-2.bin" \
		"$pkgdir/usr/lib/firmware/ath10k/WCN3990/hw1.0/laurel/board-2.bin"
}
